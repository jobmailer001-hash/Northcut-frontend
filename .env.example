# Where the app sends API requests — always the same-origin path, locally and deployed.
# Baked into the build: changing it needs a dev-server restart / redeploy.
#   Local:    Vite's dev-server proxy (vite.config.js) forwards /api/* to API_PROXY_TARGET.
#   Deployed: vercel.json forwards /api/* to the Render API.
# Never set this to the API's own domain — see CLAUDE.md → "API base URL & proxy".
VITE_API_URL=/api/v1

# Dev server only (not exposed to the browser): which API the local proxy forwards to.
# Defaults to the local API; set to https://northcut-backend.onrender.com to test against the deployed one.
API_PROXY_TARGET=http://localhost:4000

# PrimeUI licence key (free Community Licence: https://primeui.dev/licenses/community).
# Without a valid key PrimeVue shows a licence banner. Set it on Vercel too, then redeploy.
VITE_PRIMEUI_LICENSE_KEY=
